# Copy to .env and fill in. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Public address -------------------------------------------------------
PUBLIC_URL=https://consent.yourdomain.com
PORT=3000
# Behind Heroku/Render/a load balancer: 1, so rate limits see the visitor's real IP
TRUST_PROXY_HOPS=1

# --- Security (features stay OFF until these are set) ---------------------
# Websites allowed to record, exact origins, comma-separated
RECORDER_ALLOWED_ORIGINS=https://www.yourlandingpage.com
# Admin API: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=
# Key for hashing phone numbers and emails (at least 32 characters). Keep it forever:
# changing it makes existing certificates unsearchable by phone/email.
PII_HASH_SECRET=

# --- Storage --------------------------------------------------------------
STORAGE=mongo
MONGODB_URI=
MONGODB_DB=consent

BLOB_STORAGE=s3
S3_BUCKET=
AWS_REGION=us-east-1
# AWS credentials come from the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role
# For BLOB_STORAGE=local:
LOCAL_BLOB_DIR=./data/recordings

# --- Limits and retention (defaults shown) --------------------------------
MAX_CHUNK_BYTES=2097152
MAX_SESSION_BYTES=20971520
MAX_SESSION_MINUTES=60
# How long certificates are kept (TCPA claims can be brought years later)
RETENTION_DAYS=1825
# Set to false to not store visitors' IP addresses
STORE_IP=true
